# ─── Backend ─────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MINIMAX_API_KEY=your_minimax_api_key_here

# ─── Docker Ports ────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ─── Frontend URLs (only needed if NOT using the nginx proxy) ─
# By default the nginx container proxies /api/ to the backend,
# so it only needs these if you expose the backend on a separate
# domain or port that the browser hits directly.
# API_BASE_URL=http://localhost:8000
# WS_BASE_URL=ws://localhost:8000
